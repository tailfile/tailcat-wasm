@@ -0,0 +1,131 @@
+// Copyright (c) Tailfile contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+package magicsock
+
+import (
+	"net"
+	"sync/atomic"
+
+	"github.com/tailscale/wireguard-go/conn"
+	"tailscale.com/types/key"
+)
+
+// PacketPath is an embedding-supplied path for encrypted WireGuard datagrams.
+// The embedding binds its transport to peer using authenticated signaling.
+// WireGuard still authenticates every received packet. It is never plaintext.
+type PacketPath struct {
+	c    *Conn
+	peer key.NodePublic
+	send func([]byte) bool
+}
+
+type packetPathRead struct {
+	path   *PacketPath
+	packet []byte
+}
+
+// NewPacketPath replaces the optional path for peer. send must be nonblocking,
+// copy borrowed bytes before returning, and return false when unavailable/full.
+func (c *Conn) NewPacketPath(peer key.NodePublic, send func([]byte) bool) *PacketPath {
+	p := &PacketPath{c: c, peer: peer, send: send}
+	c.mu.Lock()
+	if !c.closed {
+		c.packetPaths[peer] = p
+	}
+	c.mu.Unlock()
+	return p
+}
+
+// Close only removes this generation; an old session cannot remove a new path.
+func (p *PacketPath) Close() {
+	p.c.mu.Lock()
+	if p.c.packetPaths[p.peer] == p {
+		delete(p.c.packetPaths, p.peer)
+	}
+	p.c.mu.Unlock()
+}
+
+// Receive copies and queues a datagram, dropping on overload like a UDP socket.
+func (p *PacketPath) Receive(packet []byte) bool {
+	if len(packet) == 0 || len(packet) > 65535 || p.c.closing.Load() {
+		return false
+	}
+	p.c.mu.Lock()
+	current := p.c.packetPaths[p.peer] == p
+	ep, known := p.c.peerMap.endpointForNodeKey(p.peer)
+	p.c.mu.Unlock()
+	if !current {
+		return false
+	}
+	select {
+	case p.c.packetPathRecv <- packetPathRead{p, append([]byte(nil), packet...)}:
+		return true
+	default:
+		if known {
+			ep.packetCounters.pathDrops.Add(1)
+		}
+		return false
+	}
+}
+
+func (c *Conn) sendPacketPath(peer key.NodePublic, buffs [][]byte, offset int) int {
+	c.mu.Lock()
+	p := c.packetPaths[peer]
+	c.mu.Unlock()
+	if p == nil {
+		return 0
+	}
+	for i, b := range buffs {
+		if !p.send(b[offset:]) {
+			return i
+		}
+	}
+	return len(buffs)
+}
+
+func (c *connBind) receivePacketPath(slab []byte, packets []conn.ReceivedPacket) (int, error) {
+	for r := range c.packetPathRecv {
+		if c.isClosed() {
+			return 0, net.ErrClosed
+		}
+		if r.path == nil || len(r.packet) > len(slab) {
+			continue
+		}
+		c.Conn.mu.Lock()
+		ep, known := c.peerMap.endpointForNodeKey(r.path.peer)
+		current := c.packetPaths[r.path.peer] == r.path
+		c.Conn.mu.Unlock()
+		if !known || !current {
+			continue
+		}
+		packets[0].Size = copy(slab, r.packet)
+		packets[0].Offset = 0
+		packets[0].Endpoint = ep
+		return 1, nil
+	}
+	return 0, net.ErrClosed
+}
+
+// PacketStats counts encrypted datagrams, including tunnel acknowledgements and
+// retransmissions, not application payload or outer TLS/DTLS headers.
+type PacketStats struct {
+	DERPTxBytes uint64
+	DERPRxBytes uint64
+	PathDrops   uint64
+}
+type packetCounters struct {
+	derpTxBytes atomic.Uint64
+	derpRxBytes atomic.Uint64
+	pathDrops   atomic.Uint64
+}
+
+func (c *Conn) PacketStats(peer key.NodePublic) PacketStats {
+	c.mu.Lock()
+	ep, ok := c.peerMap.endpointForNodeKey(peer)
+	c.mu.Unlock()
+	if !ok {
+		return PacketStats{}
+	}
+	return PacketStats{ep.packetCounters.derpTxBytes.Load(), ep.packetCounters.derpRxBytes.Load(), ep.packetCounters.pathDrops.Load()}
+}
